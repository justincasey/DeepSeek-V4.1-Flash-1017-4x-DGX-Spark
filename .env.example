# dsv41.sh configuration. Copy to .env and edit. Precedence: environment > .env > dsv41.sh defaults.
# Only NODES really has to match your site; everything else has a working default.

# ─── the Sparks ─────────────────────────────────────────────────────────────────────────────
# Management (LAN) addresses in ring cable order, rank 0 first. Rank 0 serves the API.
NODES="192.168.1.121 192.168.1.122 192.168.1.123 192.168.1.18"
SSH_USER=spark

# ─── checkpoint ─────────────────────────────────────────────────────────────────────────────
MODELS_DIR=/home/spark/models            # same absolute path on every node; Engram shards must be local NVMe
MODEL_REPO=deepseek-ai/DeepSeek-V4.1-Flash-1017
MODEL_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170
MODEL_NAME=DeepSeek-V4.1-Flash-1017      # directory under MODELS_DIR
CHECKSUMS=config/DeepSeek-V4.1-Flash-1017.sha256
HF_BIN=/home/spark/venvs/hf/bin/hf       # Hugging Face CLI, same path on every node (fetch downloads a quarter per node)

# ─── image and fabric ───────────────────────────────────────────────────────────────────────
IMAGE=dsv41-1017-spark:local
BUILD_DIR=/home/spark/build/dsv41-1017   # build context on rank 0
SWITCHLESS_NCCL=/home/spark/nccl-switchless-v0.0.1   # switchless NCCL bundle, same path on all four
CACHE_DIR=/home/spark/.cache/dsv41-1017  # JIT / compile caches kept across boots
CONTAINER=dsv41-1017
MASTER_PORT=29511                        # torch.distributed rendezvous on rank 0

# ─── serving ────────────────────────────────────────────────────────────────────────────────
SERVED_NAME=deepseek-v4.1-flash
HOST=0.0.0.0
PORT=8000
API_KEY=                                 # set to require "Authorization: Bearer <key>"; passed via env, never argv
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.80              # with KV_CACHE_MEMORY_BYTES set, only gates vLLM's startup free-memory check
KV_CACHE_MEMORY_BYTES=                   # fixed KV budget per rank, bytes; skips memory profiling
MOE_MODE=ep                              # ep: TP4 + EP4 | tp: MoE tensor-parallel (EP1)
DSPARK=1                                 # DSpark speculative decoding (drafter ships in the checkpoint)
NUM_SPECULATIVE_TOKENS=3
EAGER=0                                  # 1 = no CUDA graphs (first-boot / debugging)
COMPILATION_CONFIG=                      # vLLM --compilation-config JSON
MXFP8_BACKEND=cutlass                    # FP8 dense GEMM: cutlass (stock) | b12x (where K%128==0, else cutlass) | auto
NCCL_TRIM=1                              # smaller NCCL buffers (1 MiB, no LL128, 8 channels): +3-4 GiB free per node
TEXT_ONLY=0                              # 1 = --language-model-only (drops image input)
PREFIX_CACHING=1
WAIT_TIMEOUT=2400                        # seconds start waits for the API

# ─── other stacks on the same GPUs ──────────────────────────────────────────────────────────
# start refuses to run next to any container not listed here.
ALLOWED_CONTAINERS="mentatd glm53-nfs"
# stop-other / restore-other run these on the control machine. Example: the GLM-5.3 gr8 TP4 stack.
STOP_OTHER="ssh spark@192.168.1.121 'cd ~/recipes/GLM-5.3-gr8-4x-DGX-Spark-TP4/repo/gr8 && docker compose -f docker/compose.yaml exec -T gr8 /opt/gr8/gr8 glm53 down'"
RESTORE_OTHER="for n in 192.168.1.121 192.168.1.122 192.168.1.123 192.168.1.18; do ssh spark@$n 'cd ~/recipes/GLM-5.3-gr8-4x-DGX-Spark-TP4/repo/gr8 && docker compose -f docker/compose.yaml up -d'; done"

# ─── advanced ───────────────────────────────────────────────────────────────────────────────
EXTRA_VLLM_ARGS=                         # appended to vllm serve (space separated)
EXTRA_DOCKER_ARGS=                       # appended to docker run (space separated)
# Pin the ring instead of scanning it at start (doctor prints the detected values). All nine or none.
# Values are not shell-expanded: .env is parsed, not sourced. '#' starts a comment only at the start of a
# value or after whitespace (API_KEY=abc#123 is "abc#123"); quote values that contain " #".
# RING_PREFIX=24
# RING_HCA_0=rocep1s0f0,rocep1s0f1
# RING_MGMT_0=enP7s7
# RING_HCA_1=rocep1s0f1,rocep1s0f0
# RING_MGMT_1=enP7s7
# RING_HCA_2=rocep1s0f1,rocep1s0f0
# RING_MGMT_2=enP7s7
# RING_HCA_3=rocep1s0f1,rocep1s0f0
# RING_MGMT_3=enP7s7
