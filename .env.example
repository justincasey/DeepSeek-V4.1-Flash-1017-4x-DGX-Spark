# dsv41.sh configuration. Copy to .env and edit. Precedence: environment > .env > dsv41.sh defaults.
# Only NODES really has to match your site; everything else has a working default. Defaults are Christopher
# Owen's spark-ds41f r6w at shape tp4-ring (config/cluster.json @ 2dc95329), as run on a stock 4 KiB kernel.

# ─── the Sparks ─────────────────────────────────────────────────────────────────────────────
# Management (LAN) addresses in ring cable order, rank 0 first. Rank 0 serves the API.
NODES="192.168.1.121 192.168.1.122 192.168.1.123 192.168.1.18"
SSH_USER=spark

# ─── checkpoint ─────────────────────────────────────────────────────────────────────────────
MODELS_DIR=/home/spark/models            # same absolute path on every node; Engram shards 47/48 must be local files
MODEL_REPO=deepseek-ai/DeepSeek-V4.1-Flash-1017
MODEL_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170
MODEL_NAME=DeepSeek-V4.1-Flash-1017      # directory under MODELS_DIR, mounted read-only at /models
CHECKSUMS=config/DeepSeek-V4.1-Flash-1017.sha256
HF_BIN=/home/spark/venvs/hf/bin/hf       # Hugging Face CLI, same path on every node (fetch downloads a quarter per node)

# ─── image and fabric ───────────────────────────────────────────────────────────────────────
IMAGE=dsv41-1017-ds41f:r6w               # built from docker/Dockerfile (carries the patched NCCL; nothing mounted from the host)
BUILD_DIR=/home/spark/build/dsv41-1017-ds41f   # build context on rank 0
CACHE_DIR=/home/spark/.cache/dsv41-ds41f       # mounted at /cache on every node: JIT/TileLang/Triton caches, DSpark cost curves
CONTAINER=dsv41-1017                     # also names the memory guard unit (CONTAINER-memguard.service)
MASTER_PORT=9999                         # torch.distributed rendezvous on rank 0

# ─── serving ────────────────────────────────────────────────────────────────────────────────
SERVED_NAME=deepseek-v4.1-flash
HOST=0.0.0.0
PORT=8000
API_KEY=                                 # set to require "Authorization: Bearer <key>"; passed via env, never argv
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=16384             # the long-prefill threshold is this minus the decode rows, MAX_NUM_SEQS x (k+1)
GPU_MEMORY_UTILIZATION=0.82              # with KV_CACHE_MEMORY_BYTES set, only gates vLLM's startup free-memory check
KV_CACHE_MEMORY_BYTES=11274289152        # fixed KV budget per rank (10.5 GiB); empty = profile
PREFIX_CACHING=1
PREFIX_CACHE_RETENTION_INTERVAL=8192     # --prefix-cache-retention-interval (with PREFIX_CACHING=1)
KERNEL_BACKEND=tilelang                  # model kernels: tilelang (spark-ds41f r6 onward) | b12x (spark-ds41f's pre-r6 backend)
GENERATION_DEFAULTS={"temperature":1.0,"top_p":1.0}   # sampling for requests that set none; empty = vLLM's own
TEXT_ONLY=0                              # 1 = --language-model-only (drops image input)
MAX_IMAGES=4                             # images per prompt (--limit-mm-per-prompt)
WAIT_TIMEOUT=3600                        # seconds start waits for the API (first boot prepares the kernels)
STOP_GRACE=5                             # seconds stop/restart give vLLM to exit before SIGKILL (graceful exit took ~14 s;
                                         # nothing survives a stop either way)

# ─── DSpark speculative decoding and CUDA graphs ───────────────────────────────────────────
DSPARK=1                                 # drafter ships in the checkpoint
NUM_SPECULATIVE_TOKENS=5                 # k; graphs are captured up to MAX_NUM_SEQS x (k+1) rows
DRAFT_SAMPLE_METHOD=greedy               # greedy | probabilistic
ADAPTIVE_VERIFICATION_COST_SCALE=2.0     # adaptive verification against the cost curves; empty = off
DSPARK_COST_DIR=                         # empty = one directory per build (profiles once per build) | off | /cache/... path
EAGER=0                                  # 1 = no CUDA graphs (debugging)
COMPILATION_CONFIG=                      # empty = FULL_AND_PIECEWISE graphs on spark-ds41f's capture ladder; or vLLM JSON

# ─── host resources ─────────────────────────────────────────────────────────────────────────
CPUSET=5-9,15-19                         # pin each rank to GB10's ten Cortex-X925 cores (doctor checks); empty = no pin
CONTAINER_MEMORY=112g                    # docker --memory and --memory-swap; empty = no cgroup limit
DRI_CARD=/dev/dri/by-path/pci-000f:01:00.0-card   # nvidia DRM card (spark-ds41f keeps it bound at TP4 too) bound at /dev/dri/card0; empty = no mount
GPU_CLOCKS=2200                          # site policy (not a tuning knob): start locks every node's GPU with
                                         # `nvidia-smi -lgc 2200,2200` (runs 2184-2197 MHz under load); keep = leave as is
WEIGHT_SNAPSHOT=1                        # 1 = quick boot: each rank snapshots its loaded weights (~72 GiB under CACHE_DIR)
                                         # on the first boot of a build+config and reads that one file on later boots
DISPLAY_CARVEOUT=0                       # 1 = embedding and head in the display carve-out (needs DRI_CARD, nvidia-drm modeset=Y)
# Fail-closed memory guard (spark-ds41f scripts/memguard*.sh from the image, a systemd unit per node, needs
# passwordless sudo): SIGKILLs the rank when MemAvailable drops below the threshold.
STARTUP_MEMGUARD_GIB=5                   # while loading, armed before each docker run
STARTUP_MEMGUARD_INTERVAL=0.25           # seconds between samples
STARTUP_MEMGUARD_WAIT=120                # seconds the startup guard waits for its container to appear
MEMGUARD_GIB=3                           # once the API answers (must be below STARTUP_MEMGUARD_GIB)
MEMGUARD_INTERVAL=2

# ─── other stacks on the same GPUs ──────────────────────────────────────────────────────────
# start refuses to run next to any container not listed here.
ALLOWED_CONTAINERS="mentatd glm53-nfs"
# stop-other / restore-other run these on the control machine. Example: the GLM-5.3 gr8 TP4 stack.
STOP_OTHER="ssh spark@192.168.1.121 'cd ~/recipes/GLM-5.3-gr8-4x-DGX-Spark-TP4/repo/gr8 && docker compose -f docker/compose.yaml exec -T gr8 /opt/gr8/gr8 glm53 down'"
RESTORE_OTHER="for n in 192.168.1.121 192.168.1.122 192.168.1.123 192.168.1.18; do ssh spark@$n 'cd ~/recipes/GLM-5.3-gr8-4x-DGX-Spark-TP4/repo/gr8 && docker compose -f docker/compose.yaml up -d'; done"

# ─── advanced ───────────────────────────────────────────────────────────────────────────────
EXTRA_VLLM_ARGS=                         # appended to vllm serve (space separated)
EXTRA_DOCKER_ARGS=                       # appended to docker run before the image (space separated; -e K=V overrides)
# The ring, pinned so print-serve needs no ssh; doctor and start re-scan it (port IPv4 subnet vs the neighbour's)
# and refuse stale pins. Comment out RING_PREFIX to scan at every start instead. All seventeen or none.
# Per rank r: RING_HCA_PREV_r / RING_HCA_NEXT_r are the RDMA devices whose cables reach rank r-1 / r+1 (comma
# separated, in the cable subnets' sorted order when a cable carries both PCIe functions), RING_GID_r the index
# of their IPv4 RoCE v2 GID (a link flap can move it), RING_MGMT_r the bootstrap netdev.
# Values are not shell-expanded: .env is parsed, not sourced. '#' starts a comment only at the start of a
# value or after whitespace (API_KEY=abc#123 is "abc#123"); quote values that contain " #".
# This site (measured 2026-10-18): the head's cables join like ports (f0-f0 to rank 3, f1-f1 to rank 1), the
# rank 1-2 and 2-3 cables cross ports, so the head's prev/next order is the reverse of the other ranks'. Every
# cable carries both PCIe functions (rocep1s0f* and roceP2p1s0f*, one /24 each); MTU 9000, GID 3 on every port.
RING_PREFIX=24
RING_HCA_PREV_0=rocep1s0f0,roceP2p1s0f0  # 10.100.228.0/24 + 10.100.229.0/24 -> rank 3
RING_HCA_NEXT_0=rocep1s0f1,roceP2p1s0f1  # 10.100.226.0/24 + 10.100.227.0/24 -> rank 1
RING_GID_0=3
RING_MGMT_0=enP7s7
RING_HCA_PREV_1=rocep1s0f1,roceP2p1s0f1  # 10.100.226.0/24 + 10.100.227.0/24 -> rank 0
RING_HCA_NEXT_1=rocep1s0f0,roceP2p1s0f0  # 10.100.224.0/24 + 10.100.225.0/24 -> rank 2
RING_GID_1=3
RING_MGMT_1=enP7s7
RING_HCA_PREV_2=rocep1s0f1,roceP2p1s0f1  # 10.100.224.0/24 + 10.100.225.0/24 -> rank 1
RING_HCA_NEXT_2=rocep1s0f0,roceP2p1s0f0  # 10.100.230.0/24 + 10.100.231.0/24 -> rank 3
RING_GID_2=3
RING_MGMT_2=enP7s7
RING_HCA_PREV_3=rocep1s0f1,roceP2p1s0f1  # 10.100.230.0/24 + 10.100.231.0/24 -> rank 2
RING_HCA_NEXT_3=rocep1s0f0,roceP2p1s0f0  # 10.100.228.0/24 + 10.100.229.0/24 -> rank 0
RING_GID_3=3
RING_MGMT_3=enP7s7
